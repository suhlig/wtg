{
  "id": "new-workspace",
  "title": "Creating a new multi-repo workspace",
  "description": "I want a new workspace with two projects; where is my stuff?",
  "steps": [
    {
      "id": "step",
      "index": 1,
      "command": "wtg new my-feature api web",
      "cwd": "~",
      "exit_code": 0,
      "output_raw": "✓ created space \"my-feature\" on branch my-feature\n  api  ~/spaces/my-feature/api  \n  web  ~/spaces/my-feature/web  \nWorkspace root: ~/spaces/my-feature\n",
      "output_plain": "✓ created space \"my-feature\" on branch my-feature\n  api  ~/spaces/my-feature/api  \n  web  ~/spaces/my-feature/web  \nWorkspace root: ~/spaces/my-feature\n",
      "output_html": "✓ created space \u0026#34;my-feature\u0026#34; on branch my-feature\n  api  ~/spaces/my-feature/api  \n  web  ~/spaces/my-feature/web  \nWorkspace root: ~/spaces/my-feature\n"
    },
    {
      "id": "step",
      "index": 2,
      "command": "wtg path my-feature",
      "cwd": "~",
      "exit_code": 0,
      "output_raw": "~/spaces/my-feature\n",
      "output_plain": "~/spaces/my-feature\n",
      "output_html": "~/spaces/my-feature\n"
    },
    {
      "id": "step",
      "index": 3,
      "command": "wtg status my-feature",
      "cwd": "~",
      "exit_code": 0,
      "output_raw": "\u001b[1mmy-feature\u001b[m  \u001b[90m~/spaces/my-feature\u001b[m\n  api  \u001b[90m[my-feature]\u001b[m  \u001b[32m✓ clean\u001b[m  \u001b[90m(local)\u001b[m  \n  web  \u001b[90m[my-feature]\u001b[m  \u001b[32m✓ clean\u001b[m  \u001b[90m(local)\u001b[m  \n",
      "output_plain": "my-feature  ~/spaces/my-feature\n  api  [my-feature]  ✓ clean  (local)  \n  web  [my-feature]  ✓ clean  (local)  \n",
      "output_html": "\u003cspan class=\"ansi-bold\"\u003emy-feature\u003c/span\u003e  \u003cspan class=\"ansi-fg-bright-black\"\u003e~/spaces/my-feature\u003c/span\u003e\n  api  \u003cspan class=\"ansi-fg-bright-black\"\u003e[my-feature]\u003c/span\u003e  \u003cspan class=\"ansi-fg-green\"\u003e✓ clean\u003c/span\u003e  \u003cspan class=\"ansi-fg-bright-black\"\u003e(local)\u003c/span\u003e  \n  web  \u003cspan class=\"ansi-fg-bright-black\"\u003e[my-feature]\u003c/span\u003e  \u003cspan class=\"ansi-fg-green\"\u003e✓ clean\u003c/span\u003e  \u003cspan class=\"ansi-fg-bright-black\"\u003e(local)\u003c/span\u003e  \n"
    },
    {
      "id": "step",
      "index": 4,
      "command": "cat go.work",
      "cwd": "~/spaces/my-feature",
      "exit_code": 0,
      "output_raw": "go 1.22\n\nuse (\n\t./api\n\t./web\n)\n",
      "output_plain": "go 1.22\n\nuse (\n\t./api\n\t./web\n)\n",
